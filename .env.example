# Zoho OAuth2 Configuration
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token
ZOHO_ORG_ID=your_organization_id

# Zoho API base URLs (adapter selon votre datacenter : .eu, .com, .in, etc.)
ZOHO_CRM_BASE_URL=https://www.zohoapis.eu
ZOHO_INVOICE_BASE_URL=https://invoice.zoho.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu
